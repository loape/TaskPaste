{
  "name": "taskpaste",
  "version": "0.1.0",
  "type": "module",
  "bin": { "taskpaste": "./bin/ai-todo.js" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/loape/TaskPaste.git" },
  "files": ["bin", "server/index.js", "server/vision-test.png", "scripts/ocr.swift", "dist", "README.md"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts --port 4317 --no-open --dev\" \"vite --host 127.0.0.1\"",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server/index.js",
    "prepack": "npm run build",
    "start": "node bin/ai-todo.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.63.0",
    "multer": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
